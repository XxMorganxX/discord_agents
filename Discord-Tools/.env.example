# Discord bot token (create at https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token

# Discord channel ID(s) the bot will respond in (comma-separated for multiple, omit for all)
DISCORD_CHANNEL_ID=123456789012345678

# Same refresh token as your Tool Calling Mini inference server
INFERENCE_REFRESH_TOKEN=your-secret

# OpenAI API key — used only for error summarization (gpt-5-nano)
OPENAI_API_KEY=your-openai-api-key
